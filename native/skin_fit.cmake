# Match the compiler's OpenMP runtime, not an unrelated older MSVC import library.
if(WIN32 AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    get_filename_component(AF_CLANG_BIN "${CMAKE_CXX_COMPILER}" DIRECTORY)
    find_library(AF_CLANG_OMP NAMES libomp HINTS "${AF_CLANG_BIN}/../lib" NO_DEFAULT_PATH REQUIRED)
    set(OpenMP_libomp_LIBRARY "${AF_CLANG_OMP}")
    find_file(AF_OPENMP_RUNTIME NAMES libomp.dll HINTS "${AF_CLANG_BIN}" NO_DEFAULT_PATH REQUIRED)
endif()
find_package(OpenMP REQUIRED COMPONENTS CXX)
add_library(af_skin_fit OBJECT src/skin_fit.cpp src/skin_fit_validation.cpp src/skin_fit_quality.cpp)
set_target_properties(af_skin_fit PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_include_directories(af_skin_fit PRIVATE include)
target_include_directories(af_skin_fit SYSTEM PRIVATE vendor)
target_compile_definitions(af_skin_fit PRIVATE AF_NATIVE_BUILD NOMINMAX EIGEN_MPL2_ONLY EIGEN_DONT_PARALLELIZE)
target_link_libraries(af_skin_fit PRIVATE OpenMP::OpenMP_CXX)
if(MSVC)
    target_compile_options(af_skin_fit PRIVATE /W4 /WX /fp:precise)
else()
    target_compile_options(af_skin_fit PRIVATE -Wall -Wextra -Werror)
endif()
