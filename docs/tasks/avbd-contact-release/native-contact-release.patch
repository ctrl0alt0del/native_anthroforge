+#pragma once
+#include "contact_key_parts.hpp"
+namespace afcuda::fast {
+__global__ void full_contact_keys(Data f,const int* order,uint64_t* keys,int count,int part) {
+    int at=blockIdx.x*blockDim.x+threadIdx.x;
+    if(at>=count) return;
+    int id=order[at],size=min(f.state->count[f.state->epoch&1],f.capacity);
+    keys[at]=id<size?full_contact_key_part(f.raw[id],part):UINT64_MAX;
+}
+}
--- a/tools/experiments/avbd_envelope/contact_candidate_budget.hpp
+++ b/tools/experiments/avbd_envelope/contact_candidate_budget.hpp
@@ -0,0 +1,14 @@
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <stdexcept>
+inline size_t minimum_candidate_slots(int contacts,int page) {
+    if(contacts<=0||page<=0) throw std::runtime_error("Invalid contact cache capacity");
+    return std::max(size_t(4)*contacts,size_t(page));
+}
+inline size_t bounded_candidate_slots(int contacts,int page,size_t baseline_bytes,size_t budget,size_t stride) {
+    if(!stride||baseline_bytes>budget) throw std::runtime_error("Insufficient CUDA contact cache workspace");
+    size_t minimum=minimum_candidate_slots(contacts,page);
+    size_t preferred=std::max(size_t(8)*contacts,size_t(page));
+    return minimum+std::min(preferred-minimum,(budget-baseline_bytes)/stride);
+}
