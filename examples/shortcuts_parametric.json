  {"operation":"workspace.update","arguments":{"display_units":"mm"}},
  {"id":"circle","operation":"curve.create","arguments":{"name":"Parametric circle","engine":"PARAMETRIC","closed":true,"settings":{"x":"r*cos(t)","y":"r*sin(t)","z":"0*m","resolution":64,"interval":{"end_expression":"2*pi"},"variables":[{"id":"radius","name":"r","label":"Radius","dimension":"LENGTH","value":0.03}]}}},
